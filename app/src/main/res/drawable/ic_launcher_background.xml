<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de l'icone : bleu nuit profond, comme le fond du theme neon de l'app,
     avec de legeres lueurs cyan et magenta derriere le volet. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bleu nuit : centre legerement eclaire, bords quasi noirs. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="70">
                <item android:offset="0" android:color="#FF0E1A2B" />
                <item android:offset="1" android:color="#FF050A12" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lueur cyan derriere le volet. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="42">
                <item android:offset="0" android:color="#2622D3EE" />
                <item android:offset="1" android:color="#0022D3EE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lueur magenta sous le bouton de commande. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="76"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#1AE93DB2" />
                <item android:offset="1" android:color="#00E93DB2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
